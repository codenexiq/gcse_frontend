# Copy this file to .env.local and adjust if needed.
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix), so they are never sent to the browser.
# URL of the Express API (used by Next.js to proxy /api/* and for server-side fetches)
BACKEND_URL=http://localhost:5000/api

# Address tutors and admins use to sign in. Nothing on the website links to it.
# Leave it out to use /login/tutor, or pick something hard to guess, e.g. /portal-k3x9q
# (letters, numbers, - and _ only). The normal /login/tutor then stops working. Restart the server after changing.
# TUTOR_LOGIN_PATH=/portal-k3x9q
